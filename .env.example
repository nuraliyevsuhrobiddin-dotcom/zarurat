# Copy to .env for a local demo. Never commit .env.
HOST=127.0.0.1
PORT=3000
DEMO_MODE=true
DATA_DIR=./data
SECURE_COOKIE=false

# For real data: DEMO_MODE=false and DATA_DIR=./data-private (a new directory).
# Set your real phone and a unique password of at least 14 characters.
# ADMIN_PASSWORD is required only when creating the new database.
# ADMIN_PHONE=+998901234567
# ADMIN_PASSWORD="YOUR_UNIQUE_PASSWORD_HERE"

# Set SECURE_COOKIE=true when serving through HTTPS.
# Telegram, SMS and payment credentials are not read by this app yet.
